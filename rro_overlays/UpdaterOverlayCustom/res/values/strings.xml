<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Own OTA feed on Cloudflare R2 (NOT the official PixelOS server): a JSON array in the LineageOS Updater format,
         HTTPS only, no redirects, at most 1 MiB. {branch} = net.pixelos.version (seventeen), {device} = ro.custom.device (alioth). -->
    <string name="updater_server_url" translatable="false">https://ota.mywisp.uk/{branch}/API/updater/{device}.json</string>
    <string name="changelog_url" translatable="false">https://ota.mywisp.uk/{branch}/API/updater/changelogs/{device}.md</string>
    <!-- Kept on our host on purpose so the app never contacts the official PixelOS server; nothing is served there. -->
    <string name="certified_prop_url" translatable="false">https://ota.mywisp.uk/{branch}/API/updater/CertifiedProps/certified_build_props.apk</string>
</resources>
